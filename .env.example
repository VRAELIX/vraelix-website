# Copy this file to .env.local and fill in the Supabase project URL and publishable key.
# These two values are public configuration. Never put a Supabase secret/service-role key here.
VRAELIX_SUPABASE_URL=
VRAELIX_SUPABASE_PUBLISHABLE_KEY=

# Optional: set only after confirming VRAELIX's official HTTPS domain.
# VRAELIX_SITE_ORIGIN=
# Optional: set only to the real GA4 Measurement ID after the property exists.
# VRAELIX_GA4_MEASUREMENT_ID=
VRAELIX_ENQUIRY_BACKEND=zapier
VRAELIX_TURNSTILE_SITE_KEY=
